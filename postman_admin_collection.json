            "method": "GET",
            "header": [
              {
                "key": "x-mock",
                "value": "1"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/report?cohortYear=2026&track=mandatory&limit=50",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "report"],
              "query": [
                { "key": "cohortYear", "value": "2026" },
                { "key": "track", "value": "mandatory" },
                { "key": "limit", "value": "50" }
