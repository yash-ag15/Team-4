            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Explain ACID Properties with Practical Transactions\",\n  \"description\": \"Explain all four ACID properties with realistic SQL transaction examples.\",\n  \"xp\": 50,\n  \"maxMarks\": 100,\n  \"evaluationCriteria\": [\n    {\n      \"name\": \"Understanding\",\n      \"description\": \"Accurate explanation of ACID properties\",\n      \"weight\": 40\n    },\n    {\n      \"name\": \"Examples\",\n      \"description\": \"Realistic and syntactically correct transaction code\",\n      \"weight\": 30\n    },\n    {\n      \"name\": \"Clarity\",\n      \"description\": \"Clear structured explanation\",\n      \"weight\": 30\n    }\n  ],\n  \"taskData\": {\n    \"topic\": \"DBMS\",\n    \"difficulty\": \"medium\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/modules/module-1/tasks",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "modules", "module-1", "tasks"]
